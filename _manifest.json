{
  "manifest_version": 2,
  "version": "4.4.2",
  "name": "麦麦绘卷（Claude MAInet）",
  "description": "基于 MaiBot 的多模型智能绘图插件。兼容 OpenAI、OpenAI-Chat、豆包（火山方舟）、Gemini、魔搭、硅基流动、砂糖云、梦羽、智谱 GLM、阿里百炼 DashScope、ComfyUI。普通绘图支持有序参考与原生多输出，人设自拍复用统一默认，日程自拍单次发布至 MaiTrace；包含管理员联调页和旧命令、公开生图 API。",
  "plugin_type": "creative",
  "author": {
    "name": "Ptrel, Rabbit-Jia-Er, saberlights Kiuon",
    "url": "https://github.com/1021143806/mais_art_journal"
  },
  "license": "AGPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/QR-0W/mais_art_journal",
    "homepage": "https://github.com/1021143806/mais_art_journal",
    "issues": "https://github.com/1021143806/mais_art_journal/issues"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {"type": "python_package", "name": "maibot-plugin-sdk", "version_spec": ">=2.16.0,<3"},
    {"type": "python_package", "name": "httpx", "version_spec": ">=0.28,<1"},
    {"type": "python_package", "name": "requests", "version_spec": ">=2.28.0"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10"},
    {"type": "python_package", "name": "pydantic", "version_spec": ">=2,<3"},
    {"type": "python_package", "name": "tomlkit", "version_spec": ">=0.12"},
    {"type": "python_package", "name": "tzdata", "version_spec": ">=2024.1"}
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "send.command",
    "send.custom",
    "config.get",
    "config.get_plugin",
    "llm.generate",
    "message.get_by_time_in_chat",
    "message.get_by_id",
    "maisaka.context.resolve_image",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "1021143806.mais_art_journal"
}
